{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "FH6 Telemetry Mirror Hub",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.fh6.mirror.hub",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": [],
      "externalBin": [],
      "copyright": "FH6 Telemetry",
      "category": "Utility",
      "shortDescription": "Telemetry mirror middleware for Forza Horizon 6",
      "longDescription": "High-performance UDP telemetry packet duplicator for Forza Horizon 6. Mirror your game telemetry to multiple endpoints simultaneously.",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": "",
        "nsis": {
          "installerIcon": "icons/icon.ico",
          "installMode": "perUser"
        }
      },
      "linux": {
        "deb": {
          "depends": []
        }
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "FH6 Telemetry Mirror Hub",
        "width": 980,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ]
  }
}
